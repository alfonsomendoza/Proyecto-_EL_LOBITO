            <file>tests/Feature/CuentaPrincipalDivisionTest.php</file>
            <file>tests/Feature/CategoriasDesactivadasPosTest.php</file>
            <file>tests/Feature/InventarioTest.php</file>
            <file>tests/Feature/InventarioModuleTest.php</file>
            <file>tests/Feature/InventarioCategoriaFiltroTest.php</file>
            <file>tests/Feature/CatalogoCicloVidaTest.php</file>
            <file>tests/Feature/CatalogoCategoriasEstadoTest.php</file>
            <file>tests/Feature/CatalogoAutorizacionTest.php</file>
            <file>tests/Feature/RolesCatalogoTest.php</file>
            <file>tests/Feature/UsuarioModuleTest.php</file>
            <file>tests/Feature/UsuarioEditarTest.php</file>
            <file>tests/Feature/PermisosUsuariosTest.php</file>
            <file>tests/Feature/VisibilidadModulosTest.php</file>
            <file>tests/Feature/NavegacionMenuTest.php</file>
            <file>tests/Feature/SesionNavegacionTest.php</file>
            <file>tests/Feature/SesionUnicaTest.php</file>
            <file>tests/Feature/SesionUnicaMysqlTest.php</file>
            <file>tests/Feature/BackupModuleTest.php</file>
            <file>tests/Feature/ConfiguracionModuleTest.php</file>
            <file>tests/Feature/LogoutBotonAtrasTest.php</file>
            <file>tests/Feature/LoginHttpFlowTest.php</file>
