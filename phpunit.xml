<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
            <!-- Excluir los archivos que también pertenecen a RegresionClientes
                 para que PHPUnit no los registre dos veces (Warning de suite
                 duplicada). Siguen ejecutándose en su suite específica. -->
            <exclude>tests/Feature/ClienteCicloVidaTest.php</exclude>
            <exclude>tests/Feature/SubcuentasTest.php</exclude>
            <exclude>tests/Feature/MesaVaciaEstadoTest.php</exclude>
            <exclude>tests/Feature/DivisionUnidadesTest.php</exclude>
            <exclude>tests/Feature/TrasladoCuentasTest.php</exclude>
            <exclude>tests/Feature/TrasladoConsumoDestinoTest.php</exclude>
            <exclude>tests/Feature/TrasladoConsumoCocinaTest.php</exclude>
            <exclude>tests/Feature/SubdivisionSubcuentaTest.php</exclude>
            <exclude>tests/Feature/ProtegerCuentasPagadasTest.php</exclude>
            <exclude>tests/Feature/FacturaEmisionModuleTest.php</exclude>
            <exclude>tests/Feature/FacturaHistorialModuleTest.php</exclude>
            <exclude>tests/Feature/ResumenPropinasTest.php</exclude>
            <exclude>tests/Feature/CajaCierreModuleTest.php</exclude>
            <exclude>tests/Feature/ResumenDiarioModuleTest.php</exclude>
            <exclude>tests/Feature/PrefacturaImpresionTest.php</exclude>
            <exclude>tests/Feature/FacturaPrefacturaSubcuentasTest.php</exclude>
            <exclude>tests/Feature/VentasPanelTest.php</exclude>
            <exclude>tests/Feature/ComandaCuentaTest.php</exclude>
            <exclude>tests/Feature/AnularDetalleTest.php</exclude>
            <exclude>tests/Feature/AnularDetalleCocinaTest.php</exclude>
            <exclude>tests/Feature/CuentaPrincipalDivisionTest.php</exclude>
            <exclude>tests/Feature/CategoriasDesactivadasPosTest.php</exclude>
            <exclude>tests/Feature/InventarioTest.php</exclude>
            <exclude>tests/Feature/InventarioModuleTest.php</exclude>
            <exclude>tests/Feature/InventarioCategoriaFiltroTest.php</exclude>
            <exclude>tests/Feature/CatalogoCicloVidaTest.php</exclude>
            <exclude>tests/Feature/CatalogoCategoriasEstadoTest.php</exclude>
            <exclude>tests/Feature/CatalogoAutorizacionTest.php</exclude>
            <exclude>tests/Feature/RolesCatalogoTest.php</exclude>
            <exclude>tests/Feature/UsuarioModuleTest.php</exclude>
            <exclude>tests/Feature/UsuarioEditarTest.php</exclude>
            <exclude>tests/Feature/PermisosUsuariosTest.php</exclude>
            <exclude>tests/Feature/VisibilidadModulosTest.php</exclude>
            <exclude>tests/Feature/NavegacionMenuTest.php</exclude>
            <exclude>tests/Feature/SesionNavegacionTest.php</exclude>
            <exclude>tests/Feature/SesionUnicaTest.php</exclude>
            <exclude>tests/Feature/SesionUnicaMysqlTest.php</exclude>
            <exclude>tests/Feature/BackupModuleTest.php</exclude>
            <exclude>tests/Feature/ConfiguracionModuleTest.php</exclude>
            <exclude>tests/Feature/LogoutBotonAtrasTest.php</exclude>
            <exclude>tests/Feature/LoginHttpFlowTest.php</exclude>
            <exclude>tests/Feature/LoginConSesionActivaTest.php</exclude>
            <exclude>tests/Feature/DispositivoRegistroTest.php</exclude>
            <exclude>tests/Feature/TwoFactorP0Test.php</exclude>
            <exclude>tests/Feature/TwoFactorQrTest.php</exclude>
            <exclude>tests/Feature/TwoFactorPolicyTest.php</exclude>
            <exclude>tests/Feature/ProductoImportCsvTest.php</exclude>
            <exclude>tests/Feature/GastoModuleTest.php</exclude>
        </testsuite>
        <!-- Suite de regresión de clientes, subcuentas, traslados, cobros y
             facturas. Se puede ejecutar sola con:
                 php artisan test (opción testsuite=RegresionClientes)
             Está separada de la suite Feature general porque los tests aquí
             listados construyen el esquema manualmente en SQLite y pueden
             correrse en aislamiento sin depender del resto del catálogo. -->
        <testsuite name="RegresionClientes">
            <file>tests/Feature/ClienteCicloVidaTest.php</file>
            <file>tests/Feature/SubcuentasTest.php</file>
            <file>tests/Feature/MesaVaciaEstadoTest.php</file>
            <file>tests/Feature/DivisionUnidadesTest.php</file>
            <file>tests/Feature/TrasladoCuentasTest.php</file>
